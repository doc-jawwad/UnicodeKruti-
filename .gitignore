# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local Lighthouse / responsive audit artifacts
.lighthouse-tmp/
.lighthouse-mobile/
scripts/responsive-shots/
scripts/responsive-audit-results.json
scripts/responsive-findings.json

# typescript
*.tsbuildinfo
next-env.d.ts

# PWA / Workbox generated at build time
/public/sw.js
/public/sw.js.map
/public/workbox-*.js
/public/workbox-*.js.map
/public/swe-worker-*.js
/public/swe-worker-*.js.map
/public/fallback-*.js
