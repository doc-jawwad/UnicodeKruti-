# Public site URL (used for canonicals / sitemap) — no trailing slash
NEXT_PUBLIC_SITE_URL=https://unicodekruti.com

# Analytics (optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=

# Google Search Console — HTML tag method ONLY.
# In GSC: Settings → Ownership verification → HTML tag.
# Paste the meta content= value (a long token). Do NOT paste a filename
# like googlee4f355ce0321fbca.html — that is the HTML-file method and
# will be ignored by the app.
NEXT_PUBLIC_GSC_VERIFICATION=

# Bing Webmaster Tools meta content= value (optional)
NEXT_PUBLIC_BING_VERIFICATION=
