---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../layouts/SiteHeader.astro';
import SiteFooter from '../../layouts/SiteFooter.astro';
import ConverterHostIsland from '../../components/ConverterHostIsland';
import { renderWpHtmlPoc } from '../../lib/render-wp';
import { buildAstroMeta } from '../../lib/page-meta';
import { buildConverterSchema } from '@/components/seo/schema';
import { k2uFaqs, k2uFaqsHindi, k2uHowToSteps, k2uMeta, k2uToc } from '@/content/k2u';
import { schemaBreadcrumbs, uiBreadcrumbs } from '@/lib/seo/breadcrumbs';

const K2U_PATH = '/krutidev-to-unicode-converter';
const K2U_CRUMB = 'KrutiDev to Unicode Converter';

const meta = buildAstroMeta({
  title: k2uMeta.title,
  description: k2uMeta.description,
  path: K2U_PATH,
  hreflangHi: true,
});

const schema = buildConverterSchema({
  path: K2U_PATH,
  pageName: k2uMeta.title,
  pageDescription: k2uMeta.description,
  appName: 'KrutiDev to Unicode Converter',
  howToName: 'How to Convert KrutiDev Text to Unicode',
  toc: k2uToc,
  faqs: k2uFaqs,
  faqsHindi: k2uFaqsHindi,
  howToSteps: k2uHowToSteps,
  howToTotalTime: 'PT10S',
  datePublished: k2uMeta.datePublished,
  dateModified: k2uMeta.dateModified,
  breadcrumbs: schemaBreadcrumbs(K2U_CRUMB, K2U_PATH),
});

const crumbs = uiBreadcrumbs(K2U_CRUMB);
const html = renderWpHtmlPoc('krutidev-to-unicode-converter', {
  mode: 'kd-to-uni',
  variant: '010',
  lockMode: true,
});
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  ogTitle={meta.ogTitle}
  ogImageUrl={meta.ogImageUrl}
  ogWidth={meta.ogWidth}
  ogHeight={meta.ogHeight}
  ogAlt={meta.ogAlt}
  ogType={meta.ogType}
  languages={meta.languages}
  jsonLd={schema}
  jsonLdId="k2u-json-ld"
>
  <SiteHeader slot="header" />
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol>
        {
          crumbs.map((item, index) => {
            const isLast = index === crumbs.length - 1;
            return (
              <li>
                {!isLast && item.href ? (
                  <a href={item.href}>{item.label}</a>
                ) : (
                  <span class="current" aria-current="page">
                    {item.label}
                  </span>
                )}
                {!isLast ? <span class="breadcrumbs__sep" aria-hidden="true">/</span> : null}
              </li>
            );
          })
        }
      </ol>
    </nav>
  </div>
  <div class="kdd-custom-page">
    <div
      id="wp-html-root"
      class="kdd-page-html entry-content editorial-home"
      set:html={html}
    />
    <ConverterHostIsland client:only="react" rootId="wp-html-root" />
  </div>
  <SiteFooter slot="footer" />
</BaseLayout>
